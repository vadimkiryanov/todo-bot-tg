# Переменные окружения фронтенда (web/).
# Vite подхватывает только переменные с префиксом VITE_ и только на этапе сборки.

# VITE_USE_MOCK — использовать in-memory мок вместо реального REST API:
#   true  — мок (данные в localStorage, бэкенд не нужен)
#   false — реальный API через fetch /api/* (в dev — прокси Vite → :8080)
# Не задана: в dev — мок, в production — реальный API.
# Задаётся в команде, например: VITE_USE_MOCK=false npm run dev
# VITE_USE_MOCK=false

# VITE_TG_LOGIN — username Telegram-бота (без @) для кнопки «Вход через Telegram».
# Задаётся при сборке (в compose — build-arg); в dev обычно пусто (кнопка скрыта).
# VITE_TG_LOGIN=TodoVadosBot
