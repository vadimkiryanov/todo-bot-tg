# Telegram-бот (обязательно для cmd/bot и docker compose)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL (пусто — in-memory хранилище). Для docker compose обязательно:
# DATABASE_URL=postgres://todobot:todobot@db:5432/todobot
DATABASE_URL=

# Каталог файлового хранилища вложений (по умолчанию data/files)
FILES_DIR=data/files

# Адрес HTTP-сервера REST API (по умолчанию :8080; пусто — HTTP не запускается)
# HTTP_ADDR=:8080

# Срок жизни веб-сессии (Go duration, по умолчанию 720h = 30 дней)
# SESSION_TTL=720h

# Публичный домен веб-приложения для docker compose (web/Caddy):
#   todo.example.com — авто-HTTPS (Let's Encrypt)
#   :80 (по умолчанию) — просто HTTP
# APP_BASE_URL=todo.example.com
